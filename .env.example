# PayTracking — variáveis de ambiente (NUNCA coloque valores reais neste arquivo)
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://paytracking:paytracking@localhost:5432/paytracking_dev
# Neon: DATABASE_URL = pooled (-pooler); DATABASE_URL_UNPOOLED = direta, usada nas migrações.
# Sem ela, a direta é derivada da pooled. O `neon env pull` preenche as duas em .env.local
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
# 32 bytes aleatórios em base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
# false = sem proxy; em produção use o número de proxies à frente (Cloud Run: 1). "true" só em testes
TRUST_PROXY=false
PLATFORM_ADMIN_EMAILS=
EMBEDDED_WORKER=true
MIGRATE_ON_START=false

# Meta (App em developers.facebook.com; URL de redirecionamento OAuth = PUBLIC_API_URL/v1/meta/callback)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0
META_TEST_EVENT_CODE=
# Só para homologação/testes com mock da Graph API; em produção deixe vazio
META_GRAPH_BASE_URL=

# Woovi/OpenPix — assinatura mensal
WOOVI_APP_ID=
WOOVI_WEBHOOK_SECRET=
WOOVI_API_BASE=https://api.openpix.com.br
PLAN_PRICE_MINOR=4700
PLAN_TRIAL_DAYS=7

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com.br

# E-mail transacional (Resend)
RESEND_API_KEY=
MAIL_FROM=PayTracking <no-reply@seudominio.com.br>

WEBHOOK_BODY_RETENTION_DAYS=30
TRACKING_RETENTION_DAYS=180
CAPI_MAX_ATTEMPTS=10
# enabled | paused (modo sombra da migração: grava e enfileira, não envia à Meta)
CAPI_DISPATCH=enabled

# Somente para a importação única do legado (scripts/import-legacy) — remova depois
LEGACY_MYSQL_URL=
