{
  "name": "@pt/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/worker-main.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/scripts/migrate.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/scripts/seed-demo.ts",
    "import:legacy": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/scripts/import-legacy.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@pt/db": "workspace:*",
    "@pt/domain": "workspace:*",
    "@pt/gateways": "workspace:*",
    "bcryptjs": "2.4.3",
    "fastify": "5.12.7",
    "mysql2": "3.24.6",
    "nodemailer": "10.2.1",
    "pg": "8.13.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.11.10",
    "@types/web-push": "3.6.4",
    "esbuild": "0.25.12"
  }
}
