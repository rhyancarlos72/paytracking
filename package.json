{
  "name": "paytracking",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @pt/server --filter @pt/web dev",
    "build": "pnpm --filter @pt/pixel build && pnpm --filter @pt/web build && pnpm --filter @pt/server build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @pt/server db:migrate",
    "worker": "pnpm --filter @pt/server worker"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "tsx": "4.19.2",
    "@types/node": "22.10.2"
  }
}
