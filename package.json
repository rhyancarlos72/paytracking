{
  "name": "paytracking",
  "private": true,
  "type": "module",
  "main": "server.js",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @pt/server --filter @pt/web dev",
    "build": "pnpm --filter @pt/pixel build && pnpm --filter @pt/web build && pnpm --filter @pt/server build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @pt/server db:migrate",
    "worker": "pnpm --filter @pt/server worker",
    "start": "node server.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "fastify": "5.12.7"
  }
}
